{
  "name": "studio-ai-core",
  "version": "0.1.0",
  "description": "Headless, swappable-model image-editing core",
  "type": "module",
  "private": true,
  "scripts": {
    "edit": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "server": "tsx src/server.ts",
    "bot": "tsx src/telegramBot.ts"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "dotenv": "^16.4.5",
    "grammy": "^1.45.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vercel/node": "^5.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.1.5"
  }
}
